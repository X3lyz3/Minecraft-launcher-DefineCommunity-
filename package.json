{
  "name": "define-launcher",
  "version": "1.0.0",
  "description": "Define Community launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "license": "ISC",
  "dependencies": {
    "minecraft-launcher-core": "^7.0.3"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.define.launcher",
    "productName": "Define Launcher",
    "files": ["index.html", "style.css", "main.js", "package.json", "icon.ico"],
    "extraResources": [
      "bundled_data/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Define Launcher",
      "language": "1058"
    }
  }
}